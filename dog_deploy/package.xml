<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dog_deploy</name>
  <version>0.0.0</version>
  <description>Sim-to-real bridge: runs a trained TorchScript policy against the real robot</description>
  <maintainer email="danielaugustin2027@u.northwestern.edu">daniel</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>actuator</depend>
  <depend>dog_description</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>dog_imu</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- torch is not rosdep-resolvable; `pip install torch` on the Jetson
       (see README for the Jetson-specific wheel). -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
