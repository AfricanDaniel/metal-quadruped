<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dog_gym</name>
  <version>0.0.0</version>
  <description>MuJoCo/Gymnasium sim environment and RL training pipeline for the dog</description>
  <maintainer email="danielaugustin2027@u.northwestern.edu">daniel</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>dog_description</depend>

  <!--
    mujoco, gymnasium, stable_baselines3, torch are not rosdep-resolvable
    the way rclpy is: install them from requirements.txt (see README).
    Not declared as <depend> here since colcon/rosdep can't satisfy them.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
